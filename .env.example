# Copy this file to `.env` and fill in a key ONLY if you want to use --real
# (a real vision-capable model). Everything else runs with no key at all.

# Free tier, good default, and it reads images. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which model `--real` calls. Examples:
#   gemini/gemini-1.5-flash     (free tier, default)
#   anthropic/claude-opus-4-8   (best vision quality; $5/$25 per 1M tokens)
#   anthropic/claude-haiku-4-5  (cheap Claude; $1/$5 per 1M tokens)
VISION_MODEL=gemini/gemini-1.5-flash

# If you switch VISION_MODEL to Claude, set this instead of GEMINI_API_KEY.
# ANTHROPIC_API_KEY=
